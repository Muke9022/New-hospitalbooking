{
  "kind": "collectionType",
  "collectionName": "appointments",
  "info": {
    "singularName": "appointment",
    "pluralName": "appointments",
    "displayName": "Appointment",
    "description": "Patient Appointments"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "doctorId": {
      "type": "string",
      "required": true
    },
    "doctorName": {
      "type": "string",
      "required": true
    },
    "department": {
      "type": "string",
      "required": true
    },
    "date": {
      "type": "string",
      "required": true
    },
    "slotStart": {
      "type": "string",
      "required": true
    },
    "slotEnd": {
      "type": "string"
    },
    "slotLabel": {
      "type": "string",
      "required": true
    },
    "appointmentStatus": {
      "type": "enumeration",
      "default": "upcoming",
      "enum": [
        "upcoming",
        "completed",
        "cancelled"
      ]
    },
    "fee": {
      "type": "integer"
    },
    "patientName": {
      "type": "string"
    },
    "patientEmail": {
      "type": "string"
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    }
  }
}